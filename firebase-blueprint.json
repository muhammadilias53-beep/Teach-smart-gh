{
  "entities": {
    "User": {
      "title": "User",
      "description": "Teacher profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "school": { "type": "string" },
        "region": { "type": "string" },
        "district": { "type": "string" },
        "town": { "type": "string" },
        "locality": { "type": "string" },
        "level": { "type": "string" },
        "classSize": { "type": "string" },
        "mainSubject": { "type": "string" },
        "subjects": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "subjectsTaught": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "teachingExperienceYears": { "type": "number" },
        "subscriptionStatus": { "type": "string" },
        "subscriptionEndDate": { "type": "string", "format": "date-time" },
        "trialStartDate": { "type": "string", "format": "date-time" },
        "trialResetApril2024Applied": { "type": "boolean" },
        "trialResetMay2026Applied": { "type": "boolean" },
        "onboardingComplete": { "type": "boolean" },
        "isAnonymous": { "type": "boolean" },
        "photoURL": { "type": "string", "description": "Base64 encoded profile picture" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "LessonPlan": {
      "title": "LessonPlan",
      "description": "NaCCA compliant lesson plan",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "class": { "type": "string" },
        "strand": { "type": "string" },
        "subStrand": { "type": "string" },
        "contentStandard": { "type": "string" },
        "indicator": { "type": "string" },
        "performanceIndicator": { "type": "string" },
        "coreCompetencies": { "type": "string" },
        "keyWords": { "type": "string" },
        "tlrs": { "type": "string" },
        "references": { "type": "string" },
        "phase1": { "type": "string" },
        "phase2": { "type": "string" },
        "phase3": { "type": "string" },
        "locality": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Exam": {
      "title": "Exam",
      "description": "Generated examination paper and marking scheme",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "term": { "type": "string" },
        "questions": { "type": "string" },
        "markingScheme": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Scheme": {
      "title": "Scheme",
      "description": "Termly scheme of work",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "term": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Resource": {
      "title": "Resource",
      "description": "Library resources like books or documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "title", "type", "subject", "level"]
    },
    "LessonNote": {
      "title": "LessonNote",
      "description": "AI generated lesson notes for students",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string", "description": "Markdown content" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "summary": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "questions": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "title", "content", "subject", "level"]
    },
    "SavedResource": {
      "title": "SavedResource",
      "description": "Premium packs or curated resources saved by user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "resourceId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "price": { "type": "number" },
        "purchaseDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "resourceId", "title"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Professional multi-priority, targeted alerts, announcements, and resources for TeachSmartGH",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner of the notification or 'all' for broadcast" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["update", "resource", "event", "system"] },
        "read": { "type": "boolean" },
        "link": { "type": "string", "description": "Optional internal or external link" },
        "category": { "type": "string", "description": "Announcement, New Feature, Bug Fix, success, tutorial etc..." },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "pinned": { "type": "boolean" },
        "fullContent": { "type": "string", "description": "Expanded description markdown or plain text" },
        "imageUrl": { "type": "string", "description": "Optional associated image URL" },
        "pdfUrl": { "type": "string", "description": "Optional linked PDF document URL" },
        "videoUrl": { "type": "string", "description": "Optional linked YouTube or tutorial video URL" },
        "actionLabel": { "type": "string", "description": "Optional custom label for action buttons" },
        "audienceType": { "type": "string", "description": "all, trial, premium, class, subject, region, user" },
        "audienceValue": { "type": "string", "description": "Specific level value matching selection" },
        "opensCount": { "type": "number", "description": "Aggregated analytics metadata" },
        "clicksCount": { "type": "number", "description": "Aggregated analytics metadata" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "createdAt"]
    },
    "NewsHistory": {
      "title": "NewsHistory",
      "description": "Log of automatically pulled and broadcasted news items",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "processedAt": { "type": "string", "format": "date-time" }
      }
    },
    "UsedEmail": {
      "title": "UsedEmail",
      "description": "Records used email addresses for guest trials and standard accounts to prevent trial abuse",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "isAnonymous"]
    },
    "PwaLaunch": {
      "title": "PwaLaunch",
      "description": "Log of PWA launch events and standalone installations",
      "type": "object",
      "properties": {
        "displayMode": { "type": "string" },
        "referral": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "language": { "type": "string" },
        "userAgent": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["displayMode"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Individual teacher profile"
    },
    "used_emails/{email}": {
      "schema": "UsedEmail",
      "description": "Used email records mapped by email address as the document ID"
    },
    "lessonPlans/{id}": {
      "schema": "LessonPlan",
      "description": "Generated lesson plans"
    },
    "exams/{id}": {
      "schema": "Exam",
      "description": "Generated examination papers"
    },
    "schemes/{id}": {
      "schema": "Scheme",
      "description": "Generated schemes of work"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Broadcasts and personalized alerts"
    },
    "news_history/{id}": {
      "schema": "NewsHistory",
      "description": "Registry of broadcasted education news to avoid duplicates"
    },
    "resources/{resourceId}": {
      "schema": "Resource",
      "description": "User uploaded resources"
    },
    "notes/{noteId}": {
      "schema": "LessonNote",
      "description": "Saved lesson notes"
    },
    "saved_resources/{id}": {
      "schema": "SavedResource",
      "description": "Resources purchased or saved by user"
    },
    "pwa_launches/{id}": {
      "schema": "PwaLaunch",
      "description": "PWA lifecycle launch and install events"
    }
  }
}
