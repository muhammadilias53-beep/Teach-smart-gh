{
  "entities": {
    "User": {
      "title": "User",
      "description": "Teacher profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "school": { "type": "string" },
        "region": { "type": "string" },
        "district": { "type": "string" },
        "town": { "type": "string" },
        "level": { "type": "string" },
        "subjectsTaught": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "teachingExperienceYears": { "type": "number" },
        "subscriptionStatus": { "type": "string" },
        "trialStartDate": { "type": "string", "format": "date-time" },
        "photoURL": { "type": "string", "description": "Base64 encoded profile picture" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Library resources like books or documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "title", "type", "subject", "level"]
    },
    "LessonNote": {
      "title": "LessonNote",
      "description": "AI generated lesson notes for students",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string", "description": "Markdown content" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "summary": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "questions": { 
          "type": "array", 
          "items": { "type": "string" } 
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "title", "content", "subject", "level"]
    },
    "SavedResource": {
      "title": "SavedResource",
      "description": "Premium packs or curated resources saved by user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "resourceId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "price": { "type": "number" },
        "purchaseDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "resourceId", "title"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time alerts for teachers regarding curriculum, resources, or events",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner of the notification or 'all' for broadcast" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["update", "resource", "event", "system"] },
        "read": { "type": "boolean" },
        "link": { "type": "string", "description": "Optional internal or external link" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "createdAt"]
    },
    "NewsHistory": {
      "title": "NewsHistory",
      "description": "Log of automatically pulled and broadcasted news items",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "processedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Individual teacher profile"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Broadcasts and personalized alerts"
    },
    "news_history/{id}": {
      "schema": "NewsHistory",
      "description": "Registry of broadcasted education news to avoid duplicates"
    },
    "resources/{resourceId}": {
      "schema": "Resource",
      "description": "User uploaded resources"
    },
    "notes/{noteId}": {
      "schema": "LessonNote",
      "description": "Saved lesson notes"
    },
    "saved_resources/{id}": {
      "schema": "SavedResource",
      "description": "Resources purchased or saved by user"
    }
  }
}
