rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Connection Test
    match /test/connection {
      allow get: if true;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() { 
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.email == 'muhammadilias53@gmail.com'
      );
    }
    function isAdmin() {
      return isVerified() && 
             request.auth.token.email == 'muhammadilias53@gmail.com';
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && (request.auth.uid == userId || isAdmin()); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Pillar 2 & 6: Validation & PII Isolation
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('school' in data) || (data.school is string && data.school.size() <= 200)) &&
             (!('region' in data) || (data.region is string && data.region.size() <= 100)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('town' in data) || (data.town is string && data.town.size() <= 100)) &&
             (!('level' in data) || (data.level is string && data.level.size() <= 100)) &&
             (!('locality' in data) || (data.locality is string && data.locality.size() <= 100)) &&
             (!('classSize' in data) || (data.classSize is string || data.classSize is number)) &&
             (!('subjectsTaught' in data) || data.subjectsTaught is list) &&
             (!('teachingExperienceYears' in data) || (data.teachingExperienceYears is number || data.teachingExperienceYears == null)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000000)) &&
             (!('subscriptionStatus' in data) || (data.subscriptionStatus is string && data.subscriptionStatus.size() <= 50)) &&
             (!('credits' in data) || data.credits is number) &&
             (!('onboardingComplete' in data) || data.onboardingComplete is bool) &&
             (!('trialStartDate' in data) || (data.trialStartDate is timestamp || data.trialStartDate is string || data.trialStartDate == null)) &&
             (!('lastGenerationAt' in data) || (data.lastGenerationAt is timestamp || data.lastGenerationAt == null)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt == null)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt == null));
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || request.auth.token.email == 'muhammadilias53@gmail.com');
      allow list: if isSignedIn() && request.auth.token.email == 'muhammadilias53@gmail.com';
      
      allow create: if isSignedIn() && request.auth.uid == uid;
      
      allow update: if isSignedIn() && (request.auth.uid == uid || request.auth.token.email == 'muhammadilias53@gmail.com');
    }

    // Resource Library
    match /resources/{resourceId} {
      function isValidResource(data) {
        return data.authorId == request.auth.uid &&
               data.title is string && data.title.size() <= 200 &&
               data.type is string && data.type.size() <= 50 &&
               data.subject is string && data.subject.size() <= 100 &&
               data.level is string && data.level.size() <= 100 &&
               (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
               (!('url' in data) || (data.url is string && data.url.size() <= 1000));
      }

      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.authorId == 'system' || isAdmin());
      allow get: if isSignedIn();
      allow create: if isVerified() && isValidId(resourceId) && isValidResource(incoming());
      allow update: if isVerified() && isValidId(resourceId) && isOwner(existing().authorId) && isValidResource(incoming());
      allow delete: if isVerified() && isValidId(resourceId) && isOwner(existing().authorId);
    }

    // Generic rules for other owned content
    match /lessonPlans/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(id) && (incoming().authorId == request.auth.uid || isAdmin());
      allow update, delete: if isVerified() && isValidId(id) && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /exams/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(id) && (incoming().authorId == request.auth.uid || isAdmin());
      allow update, delete: if isVerified() && isValidId(id) && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /schemes/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(id) && (incoming().authorId == request.auth.uid || isAdmin());
      allow update, delete: if isVerified() && isValidId(id) && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /notes/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(id) && (incoming().authorId == request.auth.uid || isAdmin());
      allow update, delete: if isVerified() && isValidId(id) && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /saved_resources/{id} {
      allow list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(id) && (incoming().userId == request.auth.uid || isAdmin());
      allow update, delete: if isVerified() && isValidId(id) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /notifications/{id} {
      function isValidNotification(data) {
        return data.userId is string &&
               data.title is string && data.title.size() <= 200 &&
               data.message is string && data.message.size() <= 1000 &&
               data.type in ['update', 'resource', 'event', 'system'] &&
               (data.userId == 'all' || data.userId == request.auth.uid || isAdmin());
      }

      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isAdmin() && isValidId(id) && isValidNotification(incoming());
      allow update: if (isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && 
                        incoming().diff(existing()).affectedKeys().hasOnly(['read'])) || 
                      (isAdmin() && isValidNotification(incoming()));
      allow delete: if isAdmin();
    }

    match /news_history/{id} {
      allow read, write: if isAdmin();
    }
  }
}
