rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.email == 'muhammadilias53@gmail.com' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'muhammadilias53@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Phase 4: Match Blocks

    // 1. Users - Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      allow update: if (isSignedIn() && request.auth.uid == userId || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'school', 'region', 'district', 'town', 
          'level', 'subjectsTaught', 'teachingExperienceYears', 
          'photoURL', 'updatedAt', 'onboardingComplete', 'email',
          'subjects', 'locality', 'classSize', 'trialStartDate',
          'lastLoginAt', 'isAnonymous', 'subscriptionStatus', 'uid', 'createdAt',
          'mainSubject'
        ]) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Notifications
    match /notifications/{id} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        (existing().userId == request.auth.uid || existing().userId == 'all') &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isAdmin();
    }

    // 3. Resources Library
    match /resources/{resourceId} {
      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.authorId == 'system' || isAdmin());
      allow get: if isSignedIn(); // Resources can be shared/viewed if you are signed in
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    // 4. Lesson Notes, Exams, Schemes, etc.
    match /notes/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    match /lessonPlans/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    match /exams/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    match /schemes/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    // 5. Saved Resources (Purchased/Curated)
    match /saved_resources/{id} {
      allow list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // 6. News History
    match /news_history/{id} {
      allow read, write: if isAdmin();
    }

    // Connection Test
    match /test/connection {
      allow get: if true;
    }
  }
}
