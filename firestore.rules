rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return (data.uid == request.auth.uid) &&
               (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
               (!('school' in data) || (data.school is string && data.school.size() <= 200)) &&
               (!('region' in data) || (data.region is string && data.region.size() <= 100)) &&
               (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
               (!('town' in data) || (data.town is string && data.town.size() <= 100)) &&
               (!('level' in data) || (data.level is string && data.level.size() <= 100)) &&
               (!('locality' in data) || (data.locality is string && data.locality.size() <= 100)) &&
               (!('classSize' in data) || (data.classSize is string || data.classSize is number)) &&
               (!('subjectsTaught' in data) || data.subjectsTaught is list) &&
               (!('teachingExperienceYears' in data) || (data.teachingExperienceYears is number || data.teachingExperienceYears == null)) &&
               (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000000)) &&
               (!('subscriptionStatus' in data) || (data.subscriptionStatus is string && data.subscriptionStatus.size() <= 50)) &&
               (!('trialStartDate' in data) || (data.trialStartDate is timestamp || data.trialStartDate is string || data.trialStartDate == null)) &&
               (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string || data.createdAt == null)) &&
               (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string || data.updatedAt == null));
      }

      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow create: if isSignedIn() && (request.auth.uid == userId) && isValidUser(request.resource.data);
      allow update: if isSignedIn() && (request.auth.uid == userId) && isValidUser(request.resource.data);
    }

    // Resource Library Rules
    match /resources/{resourceId} {
      function isValidResource(data) {
        return data.authorId == request.auth.uid &&
               data.title is string && data.title.size() <= 200 &&
               data.type in ['PDF', 'Document', 'Link', 'Image'] &&
               data.subject is string &&
               data.level is string;
      }

      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.authorId == 'system');
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidResource(request.resource.data);
      allow update: if isOwner(resource.data.authorId) && isValidResource(request.resource.data);
      allow delete: if isOwner(resource.data.authorId);
    }

    // Lesson Plans Rules
    match /lessonPlans/{id} {
      allow list: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Exams Rules
    match /exams/{id} {
      allow list: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Schemes Rules
    match /schemes/{id} {
      allow list: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Notes Rules
    match /notes/{id} {
      allow list: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Saved Resources Rules
    match /saved_resources/{id} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
