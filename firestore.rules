rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      // Relaxed verification for better UX in AI Studio preview
      // We assume anyone signed in is authorized to create basic educational content
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muhammadilias53@gmail.com' || 
        request.auth.token.get('email', '') == 'muhammadilias53@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Phase 4: Match Blocks

    // 1. Users - Profiles
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId;
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          (!('subscriptionStatus' in incoming()) || incoming().subscriptionStatus == 'trial') &&
          (!('plan' in incoming()) || incoming().plan == null || incoming().plan == '') &&
          (!('planType' in incoming()) || incoming().planType == null || incoming().planType == '') &&
          (!('hasBulkExport' in incoming()) || incoming().hasBulkExport == false) &&
          (!('isSchoolAdmin' in incoming()) || incoming().isSchoolAdmin == false) &&
          (!('aiCredits' in incoming()) || incoming().aiCredits == 0)
        )
      );
      
      allow update: if (isOwner(userId) || isAdmin()) && (
        isAdmin() || (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'school', 'region', 'district', 'town', 
            'level', 'subjectsTaught', 'teachingExperienceYears', 
            'photoURL', 'updatedAt', 'onboardingComplete', 'email',
            'subjects', 'locality', 'classSize', 'mainSubject', 
            'trialGenerationsDate', 'trialGenerationsToday', 'trialTotalGenerations',
            'lastLoginAt', 'isAnonymous', 'uid', 'createdAt',
            'lastGenerationAt', 'preferences',
            'schoolType', 'grade', 'isBstemSchool',
            'hasSeenOnboardingTour', 'onboardingTourDismissed', 'profileCompleted',
            'acceptedTerms', 'acceptedTermsAt', 'termsVersion', 'acceptedResponsibleAiTerms',
            'aiCredits', 'quickPassGenerationsUsed', 'schoolName'
          ]) &&
          // Prevent client from increasing their own AI credits (consumption/decrement only)
          (!('aiCredits' in incoming().diff(existing()).affectedKeys()) || 
            incoming().aiCredits <= existing().get('aiCredits', 0)) &&
          // Prevent client from reducing their recorded trial generations on the same date
          (!('trialGenerationsToday' in incoming().diff(existing()).affectedKeys()) || 
            incoming().get('trialGenerationsDate', '') != existing().get('trialGenerationsDate', '') || 
            incoming().trialGenerationsToday >= existing().get('trialGenerationsToday', 0)) &&
          // Prevent client from reducing their lifetime total trial generations
          (!('trialTotalGenerations' in incoming().diff(existing()).affectedKeys()) || 
            incoming().trialTotalGenerations >= existing().get('trialTotalGenerations', 0)) &&
          // Prevent client from decreasing their quick pass usage
          (!('quickPassGenerationsUsed' in incoming().diff(existing()).affectedKeys()) || 
            incoming().quickPassGenerationsUsed >= existing().get('quickPassGenerationsUsed', 0))
        )
      );
      allow delete: if isAdmin();
    }

    // School Licenses (B2B School & Proprietor Accounts)
    match /school_licenses/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Processed Payments Ledger (Replay Protection)
    match /processed_payments/{id} {
      allow read, write: if isAdmin();
    }

    // 2. Notifications
    match /notifications/{id} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        (existing().userId == request.auth.uid || existing().userId == 'all') &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read', 'opensCount', 'clicksCount'])
      );
      allow delete: if isAdmin();
    }

    // 3. Resources Library
    match /resources/{resourceId} {
      function isValidResource(data) {
        return data.authorId == request.auth.uid;
      }

      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.authorId == 'system' || isAdmin());
      allow get: if isSignedIn();
      allow create: if isVerified() && isValidResource(incoming());
      allow update: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    // 4. Lesson Notes, Exams, Schemes, etc.
    match /notes/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    match /lessonPlans/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    // Official Headteacher Vetting Submissions
    match /vetting_submissions/{id} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Public Curriculum Verification Ledger (QR scan verification for SISOs & Supervisors)
    match /document_verifications/{id} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Official School Vetting Portals (Headteachers & Teacher Roster Directing)
    match /school_vetting_portals/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /exams/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    match /schemes/{id} {
      allow list, get: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    // 5. Saved Resources (Purchased/Curated)
    match /saved_resources/{id} {
      allow list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // 6. News History
    match /news_history/{id} {
      allow read, write: if isAdmin();
    }

    // 7. Used Emails Tracking (Guest single-use enforcement)
    match /used_emails/{email} {
      allow get: if true;
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 8. PWA Launches - Analytics
    match /pwa_launches/{id} {
      function isValidPwaLaunch(data) {
        return data.displayMode is string &&
               data.referral is string &&
               data.uid is string &&
               data.email is string &&
               data.language is string &&
               data.userAgent is string;
      }
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if isValidPwaLaunch(incoming());
      allow update, delete: if false;
    }

    // 9. Generation Feedback & NaCCA Alignment Ratings
    match /generation_feedback/{id} {
      function isValidFeedback(data) {
        return data.userId == request.auth.uid &&
               data.rating is number &&
               data.rating >= 1 && data.rating <= 5 &&
               data.generatorType is string;
      }
      allow list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidFeedback(incoming());
      allow update: if (isSignedIn() && existing().userId == request.auth.uid && isValidFeedback(incoming())) || isAdmin();
      allow delete: if isAdmin();
    }

    // Connection Test
    match /test/connection {
      allow get: if true;
    }
  }
}
